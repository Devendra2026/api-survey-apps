# Development template. Copy to `.env.development` or merge into `.env`.
# Do not store real secrets here.

NODE_ENV=development
LOG_LEVEL=debug
SWAGGER_ENABLED=true

APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Google Maps Embed API key for GIS maps on survey view and QC review (browser-exposed).
# Put the real key in repo-root .env.local only (not apps/web/.env.local).
# Enable Maps Embed API + billing; HTTP referrers: http://localhost:3000/* and http://127.0.0.1:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
CORS_ORIGIN=http://localhost:3000

PORT=4000
API_PORT=4000
WORKER_PORT=4001
WEB_PORT=3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=survey
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survey?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/survey?schema=public

REDIS_URL=redis://localhost:6379

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CLERK_CLOCK_SKEW_MS=30000
BOOTSTRAP_ADMIN_CLERK_USER_IDS=
SEED_ADMIN_CLERK_USER_ID=
ALLOW_DEV_AUTH=true

STORAGE_PROVIDER=minio
STORAGE_BUCKET=api-survey-app
STORAGE_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES=10

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000/api-survey-app
MINIO_BUCKET=api-survey-app
MINIO_REGION=us-east-1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=
AWS_S3_MAX_FILE_SIZE_BYTES=5242880
