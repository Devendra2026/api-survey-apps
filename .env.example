# Root env template for local development and as a Compose reference.
# Copy to `.env.development` (local) or paste into Dokploy Environment UI (production).
# Per-service production templates: deploy/env/{api,web,worker}.env.example
# Full matrix: docs/ops/dokploy-env.md

NODE_ENV=development

# Postgres (local docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=survey
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survey?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/survey?schema=public

# Redis / MinIO (local compose — Redis has no password)
REDIS_URL=redis://localhost:6379
# Production Dokploy also requires REDIS_PASSWORD (compose wires REDIS_URL)
# REDIS_PASSWORD=
STORAGE_PROVIDER=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=api-survey-app
STORAGE_BUCKET=api-survey-app

# App URLs
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk (required for auth)
CLERK_SECRET_KEY=sk_test_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Demand notice print HMAC
DEMAND_NOTICE_PRINT_SECRET=CHANGE_ME_LONG_RANDOM

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
LOG_LEVEL=info
SWAGGER_ENABLED=true
