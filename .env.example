# =============================================================================
# Single monorepo env file — copy to `.env` and fill in secrets:
#   cp .env.example .env
#
# Loaded by: Nest API, Next.js web, Prisma, docker compose (auto).
# Optional overrides: `.env.local` (same folder; gitignored; wins over `.env`).
# =============================================================================

NODE_ENV=development

# --- PostgreSQL (docker-compose / Prisma) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=survey
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survey?schema=public

# --- NestJS API ---
PORT=4000
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- Next.js web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
JWT_AUDIENCE=
JWT_ISSUER=

# --- AWS S3 (see docs/aws-s3-setup.md) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=api-survey-app
# Leave empty → https://{bucket}.s3.{region}.amazonaws.com/{key}
# Set only for CloudFront / CDN base URL (no trailing slash, no /{key}).
AWS_S3_PUBLIC_URL=
AWS_S3_MAX_FILE_SIZE_BYTES=5242880
