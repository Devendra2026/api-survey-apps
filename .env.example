# =============================================================================
# API Survey Apps environment template
# =============================================================================
#
# Precedence:
# 1. Real process environment values always win (CI, Dokploy, shell exports).
# 2. Nest API and Next.js load repo-root `.env.local` first, then `.env`.
# 3. Docker Compose interpolates from shell values and repo-root `.env`.
# 4. `.env.*.example` files are documentation/templates only; never put secrets
#    in examples and never commit real `.env`, `.env.local`, or production files.
#
# Suggested local flow:
#   cp .env.example .env
#   cp .env.development.example .env.development
# Then put private overrides in `.env.local` if needed.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- App URLs ---
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Google Maps Embed API key for GIS maps on survey view and QC review (browser-exposed).
# Set in repo-root .env.local only — a different value in apps/web/.env.local overrides and breaks embeds.
# Enable Maps Embed API + billing; HTTP referrers: http://localhost:3000/* http://127.0.0.1:3000/*
# Verify: npm run verify:google-maps-key -- --referer http://localhost:3000/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
CORS_ORIGIN=http://localhost:3000

# --- Ports ---
PORT=4000
API_PORT=4000
WORKER_PORT=4001
WEB_PORT=3000

# --- PostgreSQL / Prisma ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=survey
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survey?schema=public
# DIRECT_URL is used by migration tooling when transaction pooling is enabled.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/survey?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Clerk ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# JWT clock skew tolerance in ms (Clerk default is 5000; 30000 is safer for local Windows drift).
CLERK_CLOCK_SKEW_MS=30000
# Comma-separated Clerk user IDs (user_...) that receive ADMIN on first API login if they have no roles.
BOOTSTRAP_ADMIN_CLERK_USER_IDS=
# Optional: seed a real Clerk user as global ADMIN (used by `pnpm db:seed`).
SEED_ADMIN_CLERK_USER_ID=
# Dev-only: set to "true" to allow x-dev-clerk-user-id when CLERK_SECRET_KEY is unset (never in production).
ALLOW_DEV_AUTH=false

# --- Object storage ---
# Supported values: minio, s3
STORAGE_PROVIDER=minio
STORAGE_BUCKET=api-survey-app
STORAGE_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES=10

# MinIO for local/development-compatible S3.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000/api-survey-app
MINIO_BUCKET=api-survey-app
MINIO_REGION=us-east-1

# AWS S3 for production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=api-survey-app
# Leave empty -> https://{bucket}.s3.{region}.amazonaws.com/{key}
# Set only for CloudFront / CDN base URL (no trailing slash, no /{key}).
AWS_S3_PUBLIC_URL=
AWS_S3_MAX_FILE_SIZE_BYTES=5242880

# --- Mailpit (development SMTP sink) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
