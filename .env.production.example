# Production template for Dokploy/CI secret managers.
# Do not store real secrets here; set these in Dokploy, GitHub Actions, or a vault.

NODE_ENV=production
LOG_LEVEL=info
SWAGGER_ENABLED=false

APP_URL=https://app.example.com
API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com

PORT=4000
API_PORT=4000
WORKER_PORT=4001
WEB_PORT=3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
REDIS_URL=redis://redis:6379

CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_AUTHORIZED_PARTIES=https://app.example.com
CLERK_CLOCK_SKEW_MS=30000
BOOTSTRAP_ADMIN_CLERK_USER_IDS=
SEED_ADMIN_CLERK_USER_ID=
JWT_AUDIENCE=
JWT_ISSUER=

STORAGE_PROVIDER=s3
STORAGE_BUCKET=api-survey-app-prod
STORAGE_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MAX_FILES=10

AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=ap-south-1
AWS_S3_BUCKET=api-survey-app-prod
AWS_S3_PUBLIC_URL=https://cdn.example.com
AWS_S3_MAX_FILE_SIZE_BYTES=10485760

# Only set MinIO values in production if STORAGE_PROVIDER=minio.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=
MINIO_PUBLIC_URL=
MINIO_BUCKET=
MINIO_REGION=us-east-1
