{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": ["...", "pnpm --filter @workspace/database db:generate", "pnpm turbo build --filter=api..."]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter api start",
    "variables": {
      "NODE_ENV": "production",
      "PORT": "4000",
      "HOSTNAME": "0.0.0.0"
    },
    "aptPackages": ["curl", "wget"]
  }
}
