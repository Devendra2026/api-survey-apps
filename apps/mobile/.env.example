# Public client-safe vars only — never put secrets here.
# Copy to apps/mobile/.env or apps/mobile/.env.local
# Canonical template: deploy/env/mobile.env.example

# LOCAL (Metro / emulator) → local Nest + Clerk pk_test_
# PREVIEW (EAS profile preview) → staging/preview Nest + matching Clerk (usually pk_test_ or staging)
# PRODUCTION (EAS profile production) → production HTTPS Nest + Clerk pk_live_
# Never mix Clerk instances with the wrong API.

# Nest API base URL (no trailing slash).
# Android emulator: http://10.0.2.2:4000
# iOS simulator: http://localhost:4000
# Physical device: http://<LAN-IP>:4000
# Preview: https://your-staging-api.example.com
# Production: https://backend.sdvedutech.in (HTTPS required; http:// / localhost rejected)
EXPO_PUBLIC_API_URL=

# Clerk publishable key only. Never CLERK_SECRET_KEY.
# Local / development: pk_test_…
# Preview: Clerk instance that matches the preview API (often pk_test_ or staging)
# Production: pk_live_… (pk_test_ rejected in production builds)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google Maps SDK key (public). Used for both Android and iOS native maps config.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Also set per EAS build profile via eas.json.
# APP_ENV=development | preview | production

