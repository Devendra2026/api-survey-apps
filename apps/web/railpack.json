{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": ["...", "pnpm turbo build --filter=web..."]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter web start",
    "variables": {
      "NODE_ENV": "production",
      "PORT": "3000",
      "HOSTNAME": "0.0.0.0",
      "NEXT_TELEMETRY_DISABLED": "1"
    },
    "aptPackages": ["curl", "wget"]
  }
}
