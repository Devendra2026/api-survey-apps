# API service — copy to api.env (never commit secrets)
# For Dokploy single Compose stack, prefer: deploy/env/dokploy.compose.env.example
NODE_ENV=production
PORT=4000
HOSTNAME=0.0.0.0

DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/survey?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@postgres:5432/survey?schema=public
# Prefer POSTGRES_* — Dokploy compose entrypoints rebuild DATABASE_URL from these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=survey
# URL-safe password (avoid @ : /). Dokploy compose builds REDIS_URL from this — do not set a static REDIS_URL.
REDIS_PASSWORD=CHANGE_ME_URL_SAFE

CORS_ORIGIN=https://admin.sdvedutech.in,https://portal.nppetah.in
APP_URL=https://admin.sdvedutech.in
API_URL=https://backend.sdvedutech.in
NEXT_PUBLIC_API_URL=https://backend.sdvedutech.in

CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_AUTHORIZED_PARTIES=https://admin.sdvedutech.in,https://portal.nppetah.in
# Must differ from CLERK_SECRET_KEY (Etah portal clerk.nppetah.in sk_live_).
PORTAL_CLERK_SECRET_KEY=sk_live_REPLACE_ME_ETAH_PORTAL
PORTAL_CLERK_AUTHORIZED_PARTIES=https://portal.nppetah.in,https://clerk.nppetah.in
# Comma-separated Clerk Dashboard user IDs; configure before first production sign-in.
BOOTSTRAP_ADMIN_CLERK_USER_IDS=user_REPLACE_ME
# Catalog seed is one-time (not on migrate): SEED_DEMO=false pnpm --filter @workspace/database db:seed

DEMAND_NOTICE_PRINT_SECRET=CHANGE_ME_LONG_RANDOM

STORAGE_PROVIDER=minio
MINIO_ROOT_USER=CHANGE_ME_USER
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=api-survey-app
STORAGE_BUCKET=api-survey-app

SWAGGER_ENABLED=false
LOG_LEVEL=info

# Optional ETL (Convex → Postgres / MinIO) — set on API and Worker
ETL_ENABLED=true
CONVEX_SITE_URL=https://site.sdvedutech.in
ETL_CONVEX_SECRET=CHANGE_ME_MATCH_CONVEX_ETL_SECRET
ETL_BATCH_SIZE=100
ETL_CRON=*/15 * * * *
