# Dokploy Compose — paste into Environment UI (Compose app).
# File: docker-compose.dokploy.yml | App example: sdv-frontend-app-qrll5q
#
# Replace every REPLACE_ME_* value. Do not commit real secrets.
#
# Full matrix: docs/ops/dokploy-env.md
# UI steps: docs/ops/dokploy-compose-setup.md

NODE_ENV=production

# --- Required for `docker compose up` interpolation (fail closed; no defaults) ---
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD_URL_SAFE
MINIO_ROOT_USER=REPLACE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_PASSWORD

# Optional infra names (compose has defaults)
POSTGRES_USER=postgres
POSTGRES_DB=survey
MINIO_BUCKET=api-survey-app
STORAGE_BUCKET=api-survey-app

# --- Database connection (single source of truth) ---
# migrate / api / worker entrypoints BUILD DATABASE_URL from POSTGRES_* above
# (password is URL-encoded). Host is always Compose service name `postgres`.
# Do NOT paste DATABASE_URL/DIRECT_URL for in-compose Postgres — a drifted URL
# causes Prisma P1000. Only set them for an external Postgres (host != postgres).
# DATABASE_URL=
# DIRECT_URL=

# Optional migrate diagnostics (env keys + filesystem; never prints secrets)
# DEBUG_STARTUP=true

# Do NOT set REDIS_URL here — compose builds redis://:${REDIS_PASSWORD}@redis:6379 for api/worker.
# A static REDIS_URL with the wrong password causes Redis auth failures.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000

# --- Required for api / web runtime (Clerk + app URLs) ---
CORS_ORIGIN=https://admin.sdvedutech.in,https://portal.nppetah.in
APP_URL=https://admin.sdvedutech.in
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_AUTHORIZED_PARTIES=https://admin.sdvedutech.in,https://portal.nppetah.in
# Etah portal uses its own Clerk instance (login on portal.nppetah.in).
# PORTAL_CLERK_SECRET_KEY must be the portal sk_live_ and MUST differ from CLERK_SECRET_KEY.
PORTAL_CLERK_SECRET_KEY=sk_live_REPLACE_ME_ETAH_PORTAL
PORTAL_CLERK_AUTHORIZED_PARTIES=https://portal.nppetah.in,https://clerk.nppetah.in
DEMAND_NOTICE_PRINT_SECRET=REPLACE_ME_LONG_RANDOM

# First production admin — Clerk Dashboard → Users → user id (user_…).
# After deploy, api logs should say: BOOTSTRAP_ADMIN_CLERK_USER_IDS configured (1 id(s))
# SEED_ADMIN_CLERK_USER_ID is demo-seed only; API bootstrap uses this key.
BOOTSTRAP_ADMIN_CLERK_USER_IDS=user_REPLACE_ME

# --- Required for web image BUILD (compose build.args) ---
NEXT_PUBLIC_API_URL=https://backend.sdvedutech.in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# In-app SignIn/SignUp paths — stop Clerk Account Portal (accounts.*) fallback
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
ETAH_PORTAL_URL=https://portal.nppetah.in
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Required on the Dokploy host for backup/restore scripts (not injected into app containers) ---
BACKUP_ROOT=/backups

# --- ETL (Convex sync) — required on api + worker for Master Data /admin/etl ---
ETL_ENABLED=true
CONVEX_SITE_URL=https://site.sdvedutech.in
# Must equal Convex `npx convex env set ETL_SECRET`. Use URL/shell-safe characters:
# a '#' starts a comment in this file and would silently truncate the value.
# Verify with `pnpm etl:run preflight` — both sides print the same fingerprint.
ETL_CONVEX_SECRET=REPLACE_ME_MATCH_CONVEX_ETL_SECRET
ETL_BATCH_SIZE=100
ETL_CRON=*/15 * * * *
# ETL_SYSTEM_USER_ID=
# ETL_MAX_RETRIES=5
# Minutes without progress before an ETL job is closed as abandoned.
# ETL_STALE_JOB_TIMEOUT_MINUTES=60

# Optional app/deploy controls
# Catalog seed is NOT run by migrate. One-time after first deploy (from a host that can reach Postgres):
#   SEED_DEMO=false DATABASE_URL=... DIRECT_URL=... pnpm --filter @workspace/database db:seed
# LOG_LEVEL=info
# SWAGGER_ENABLED=false
# WEB_HOST=admin.sdvedutech.in
# API_HOST=backend.sdvedutech.in
