# Dokploy Compose — paste into Environment UI (Compose app).
# File: docker-compose.dokploy.yml | App example: sdv-frontend-app-qrll5q
#
# Replace every REPLACE_ME_* value. Do not commit real secrets.
# Host for Postgres URLs MUST be `postgres` (Compose service name), not localhost.
#
# Full matrix: docs/ops/dokploy-env.md
# UI steps: docs/ops/dokploy-compose-setup.md

NODE_ENV=production

# --- Required for `docker compose up` interpolation (fail closed; no defaults) ---
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_ME_REDIS_PASSWORD_URL_SAFE
MINIO_ROOT_USER=REPLACE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_PASSWORD

# Optional infra names (compose has defaults)
POSTGRES_USER=postgres
POSTGRES_DB=survey
MINIO_BUCKET=api-survey-app
STORAGE_BUCKET=api-survey-app

# --- Required for migrate / api / worker (compose interpolates + injects) ---
# Password in these URLs MUST match POSTGRES_PASSWORD exactly.
DATABASE_URL=postgresql://postgres:REPLACE_ME_POSTGRES_PASSWORD@postgres:5432/survey?schema=public
DIRECT_URL=postgresql://postgres:REPLACE_ME_POSTGRES_PASSWORD@postgres:5432/survey?schema=public

# Do NOT set REDIS_URL here — compose builds redis://:${REDIS_PASSWORD}@redis:6379 for api/worker.
# A static REDIS_URL with the wrong password causes Redis auth failures.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000

# --- Required for api / web runtime (Clerk + app URLs) ---
CORS_ORIGIN=https://admin.sdvedutech.in
APP_URL=https://admin.sdvedutech.in
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_AUTHORIZED_PARTIES=https://admin.sdvedutech.in
DEMAND_NOTICE_PRINT_SECRET=REPLACE_ME_LONG_RANDOM

# First production admin — Clerk Dashboard → Users → user id (user_…).
# After deploy, api logs should say: BOOTSTRAP_ADMIN_CLERK_USER_IDS configured (1 id(s))
# SEED_ADMIN_CLERK_USER_ID is demo-seed only; API bootstrap uses this key.
BOOTSTRAP_ADMIN_CLERK_USER_IDS=user_REPLACE_ME

# --- Required for web image BUILD (compose build.args) ---
NEXT_PUBLIC_API_URL=https://backend.sdvedutech.in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Required on the Dokploy host for backup/restore scripts (not injected into app containers) ---
BACKUP_ROOT=/backups

# Optional app/deploy controls
# Catalog seed is NOT run by migrate. One-time after first deploy (from a host that can reach Postgres):
#   SEED_DEMO=false DATABASE_URL=... DIRECT_URL=... pnpm --filter @workspace/database db:seed
# LOG_LEVEL=info
# SWAGGER_ENABLED=false
# WEB_HOST=admin.sdvedutech.in
# API_HOST=backend.sdvedutech.in
