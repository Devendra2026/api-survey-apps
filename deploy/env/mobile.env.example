# Public client-safe vars only — never put secrets here.
# Copy into apps/mobile/.env or apps/mobile/.env.local before `pnpm --filter mobile dev`.
# Expo only inlines EXPO_PUBLIC_* into the JS bundle.

# Nest API base URL (no trailing slash).
# Android emulator → host machine: http://10.0.2.2:4000
# iOS simulator / Expo web → http://localhost:4000
# Physical device → machine LAN IP (e.g. http://192.168.1.20:4000).
#   When unset, the app tries the Expo Metro host on port 4000 for physical devices.
# Production → https://your-api.example.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Clerk publishable key only. Never the secret key (CLERK_SECRET_KEY).
# Local / Metro: use pk_test_… (Clerk LogBox “development keys” warning is expected).
# Release / store builds: use pk_live_… from the Clerk Dashboard production instance
#   (same publishable key family as web NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_DEV_PUBLISHABLE_KEY
