# Public client-safe vars only — never put secrets here.
# Load via Expo (EXPO_PUBLIC_*) or set in the environment before `pnpm --filter mobile dev`.

# Nest API base URL (no trailing slash).
# Android emulator → host machine: http://10.0.2.2:4000
# iOS simulator / Expo web → http://localhost:4000
# Physical device → use your machine's LAN IP (do not commit a personal IP).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Future (option B — Clerk). Publishable key only; never the secret key.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
