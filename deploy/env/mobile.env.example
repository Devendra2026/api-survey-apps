# Public client-safe vars only — never put secrets here.
# Copy into apps/mobile/.env or apps/mobile/.env.local before `pnpm --filter mobile dev`.
# Expo only inlines EXPO_PUBLIC_* into the JS bundle.
# Also mirrored at apps/mobile/.env.example for local discovery.

# Pair environments carefully:
#   LOCAL / DEVELOPMENT (Metro, EAS profile `development`)
#     → EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_…  + local Nest API
#   PREVIEW / INTERNAL TEST (EAS profile `preview`, EAS environment `preview`)
#     → Clerk key for the staging/preview instance + staging/preview Nest API (HTTPS preferred)
#   PRODUCTION (EAS profile `production`, EAS environment `production`)
#     → EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_…  + production Nest API (HTTPS required)
# Never mix development Clerk with a production API (or the reverse).
# Never ship localhost / 10.0.2.2 / staging API URLs in a production binary.

# Nest API base URL (no trailing slash).
# Android emulator → host machine: http://10.0.2.2:4000
# iOS simulator / Expo web → http://localhost:4000
# Physical device → machine LAN IP (e.g. http://192.168.1.20:4000).
#   When unset in __DEV__, the app tries the Expo Metro host on port 4000 for physical devices.
# Preview → https://your-staging-api.example.com (set in EAS environment `preview`)
# Production → https://backend.sdvedutech.in (set in EAS environment `production`; http:// / localhost rejected)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Clerk publishable key only. Never the secret key (CLERK_SECRET_KEY).
# Local / Metro / development builds: use pk_test_… (Clerk LogBox “development keys” warning is expected).
# Preview: use the Clerk instance that matches the preview/staging API (usually pk_test_ or a dedicated staging app).
# Release / store builds: use pk_live_… from the Clerk Dashboard production instance
#   (same publishable key family as web NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Production builds reject pk_test_ keys (see getClerkPublishableKey in apps/mobile/src/lib/env.ts).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_DEV_PUBLISHABLE_KEY

# Google Maps for the survey GPS screen. Public client key only — never a secret key.
# Local, preview, and production builds read EXPO_PUBLIC_GOOGLE_MAPS_API_KEY (Android + iOS).
# Do not rely on EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY / _IOS_KEY — those names are not wired.
# Leave blank in git. Set the real key in apps/mobile/.env.local or the matching EAS environment.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional stamp used by app.config / eas.json (also set per EAS build profile).
# APP_ENV=development | preview | production

# Google sign-in uses Clerk SSO (browser OAuth via useSSO), not a separate native Google SDK.
# Canonical redirect (exact, no trailing slash) — allowlist on EVERY Clerk instance used by mobile:
#   Clerk Dashboard → Native applications → Allowlist for mobile SSO redirect
#   mobile://sso-callback
# Local (pk_test_), Preview (EAS preview key), and Production (pk_live_) each need that exact entry.

# --- EAS (required for cloud builds) ---
# apps/mobile/.env* is gitignored and is NOT uploaded to EAS Build.
# Create/update the same three NAMES in EAS environments development / preview / production
# (eas.json already binds each build profile via `"environment"`):
#   EXPO_PUBLIC_API_URL (public)
#     development: http://10.0.2.2:4000 or device LAN (dev client)
#     preview: HTTPS staging API, or production Nest until staging exists
#     production: https://backend.sdvedutech.in
#   EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (public) — match the API's Clerk instance
#     development: pk_test_… ; production (and preview-against-prod): pk_live_…
#   EXPO_PUBLIC_GOOGLE_MAPS_API_KEY (public)
# Example: eas env:set production --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_live_… --visibility plaintext
# Server secrets (CLERK_SECRET_KEY, DATABASE_URL, REDIS_*, MINIO_*) stay on Nest / Dokploy only.
