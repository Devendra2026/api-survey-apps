# Web (Next.js) service — copy to web.env (never commit secrets)
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Baked into the image at build time — changing either value requires rebuilding the web image.
# Set these as Docker build args / Dokploy build environment, not only runtime variables.
NEXT_PUBLIC_API_URL=https://backend.sdvedutech.in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Clerk (if used by Next server components / middleware)
CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
