# Worker (BullMQ) service — copy to worker.env (never commit secrets)
NODE_ENV=production
WORKER_PORT=4001
HOSTNAME=0.0.0.0

DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/survey?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@postgres:5432/survey?schema=public
REDIS_PASSWORD=CHANGE_ME_URL_SAFE
REDIS_URL=redis://:CHANGE_ME_URL_SAFE@redis:6379

STORAGE_PROVIDER=minio
MINIO_ROOT_USER=CHANGE_ME_USER
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=api-survey-app
STORAGE_BUCKET=api-survey-app

LOG_LEVEL=info

# ETL consumer (must match API Convex settings)
CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site
ETL_CONVEX_SECRET=CHANGE_ME_MATCH_CONVEX_ETL_SECRET
ETL_SYSTEM_USER_ID=
ETL_MAX_RETRIES=5
