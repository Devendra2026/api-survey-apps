{
  "name": "api-survey-apps",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=api --filter=web --filter=worker",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:deploy": "pnpm --filter @workspace/database db:deploy",
    "db:seed": "pnpm --filter @workspace/database db:seed",
    "verify:dev": "node scripts/verify-dev.mjs",
    "verify:google-maps-key": "node ./scripts/verify-google-maps-key.mjs",
    "etl:run": "node ./scripts/etl-run.mjs",
    "etl:full": "node ./scripts/etl-run.mjs full",
    "etl:incremental": "node ./scripts/etl-run.mjs incremental",
    "etl:status": "node ./scripts/etl-run.mjs status",
    "prepare": "node -e \"try{require('fs').accessSync('.git');require('child_process').execSync('husky',{stdio:'inherit'})}catch{}\""
  },
  "devDependencies": {
    "@workspace/database": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/validation": "workspace:*",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.4"
}
