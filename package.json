{
  "name": "api-survey-apps",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=api --filter=web --filter=worker --filter=mobile",
    "dev:mobile": "pnpm --filter mobile dev",
    "mobile:android": "pnpm --filter mobile android",
    "mobile:android:boot": "pnpm --filter mobile android:boot",
    "mobile:ios": "pnpm --filter mobile ios",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start",
    "start:worker": "pnpm --filter worker start",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @workspace/database db:migrate",
    "db:deploy": "pnpm --filter @workspace/database db:deploy",
    "db:seed": "pnpm --filter @workspace/database db:seed",
    "admin:promote": "pnpm --filter api promote-admin",
    "verify:dev": "node scripts/verify-dev.mjs",
    "verify:google-maps-key": "node ./scripts/verify-google-maps-key.mjs",
    "etl:run": "node ./scripts/etl-run.mjs",
    "etl:secret": "node ./scripts/ops/etl-secret.mjs",
    "etl:full": "node ./scripts/etl-run.mjs full",
    "etl:incremental": "node ./scripts/etl-run.mjs incremental",
    "etl:status": "node ./scripts/etl-run.mjs status",
    "prepare": "node -e \"try{require('fs').accessSync('.git');require('child_process').execSync('husky',{stdio:'inherit'})}catch{}\""
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
