// =============================================================================
// Municipal Property Tax Survey Management System — Prisma Schema
// Shared Database + Shared Schema | Tenant grain = Ulb (ulbId)
// Auth: Clerk (clerkUserId) | RBAC: UserTenantRole (no direct User.role)
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum OwnershipType {
  INDIVIDUAL
  JOINT
  LIMITED_COMPANY_FIRM
  TRUST_SOCIETY
  RELIGIOUS_BODY
  STATE_GOVERNMENT_BODY
  CENTRAL_GOVERNMENT_BODY
  MUNICIPAL_COUNCIL_TOWN_PANCHAYAT
  LEASE_PROPERTY
}

enum PropertyUse {
  RESIDENTIAL
  COMMERCIAL
  OPEN_LAND
  RELIGIOUS_PROPERTY
  MIX_PROPERTY
}

enum PropertyType {
  RESIDENTIAL_SELF
  RESIDENTIAL_RENTED
  SHOP_BAKERY
  BANK_OFFICE
  SCHOOL_COLLEGE
  MALL_SHOWROOM
  PETROL_PUMP
  HOTEL_MARRIAGE_RESTAURANT
  HOSPITAL_NURSING_PATHOLOGY
  GODOWN
  CENTRAL_GOVERNMENT
  STATE_GOVERNMENT
  INDUSTRY
  COLD_STORE
  OPEN
  AGRICULTURE
  OPEN_LAND_GODOWN
  MANDIR
  MASJID
  TRUST_DHARAMSHALA
  SHAMSHAN_KABRISTAN
  GURUDWARA_CHURCH
  RESIDENTIAL_AND_COMMERCIAL
}

enum Situation {
  MAIN_MARKET
  MAIN_ROAD
  INTERIOR
}

enum RoadType {
  RCC
  DAMBAR
  KACCHA
}

enum TaxRateZone {
  BELOW_9M
  METER_9_TO_12
  METER_12_TO_24
  ABOVE_24M
}

/// Financial assessment year (label 2025-2026 → AY_2025_2026)
enum AssessmentYear {
  AY_2025_2026
  AY_2026_2027
}

enum WaterConnection {
  YES
  NO
  PARTIAL
}

enum SourceOfWater {
  GOVERNMENT_TAP
  DUG_WELL
  BOREWELL
  OTHER
}

enum SanitationType {
  SEWER_SYSTEM
  SEPTIC_TANK
  SURFACE_DRAIN
  NO_TOILET
  OTHER
}

enum SurveyStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  REOPENED
}

/// Independent QC axis (legacy Convex qcStatus). Approve/reject decisions live here.
enum QcStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UsageFactor {
  RESIDENTIAL
  COMMERCIAL
  MIXED
  AGRICULTURE
  GODOWN
  OPEN_LAND
  UNDER_CONSTRUCTION

  @@map("usageFactor")
}

enum UsageType {
  SELF_OCCUPIED
  RENTED

  @@map("usageType")
}

enum ConstructionType {
  PAKKA_BUILDING_WITH_RCC_ROOF
  TIN_SHED
  OPEN_LAND
  UNDER_CONSTRUCTION
  KACCHA_BUILDING
}

enum FloorPosition {
  BASEMENT
  GROUND_FLOOR
  FIRST_FLOOR
  SECOND_FLOOR
  THIRD_FLOOR
  FOURTH_FLOOR
  FIFTH_FLOOR
  SIXTH_FLOOR
  OPEN_LAND
}

enum PhotoType {
  FRONT
  SIDE
  INSIDE
  DOCUMENT
}

enum UlbType {
  MUNICIPAL_COUNCIL
  TOWN_PANCHAYAT
}

/// @deprecated Legacy axis label — prefer latitude/longitude Decimal fields.
enum GPSCordinates {
  LATITUDE
  LONGITUDE
}

enum StorageProvider {
  S3
  MINIO
}

enum JobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum MigrationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
}

enum MigrationJobType {
  FULL
  INCREMENTAL
  RETRY_FAILED
  VALIDATE
  REFRESH_PENDING
}

enum ExportFormat {
  CSV
  XLSX
  PDF
  JSON
}

enum GpsSource {
  DEVICE
  MANUAL
  IMPORT
}

// -----------------------------------------------------------------------------
// Geography hierarchy: State → District → Ulb → Ward
// -----------------------------------------------------------------------------

enum GeoEntityStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum ReferenceEntryStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum TaxConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Top-level administrative unit (e.g. Telangana).
model State {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  status    GeoEntityStatus @default(ACTIVE)
  updatedBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  districts       District[]
  surveys         Survey[]
  userTenantRoles UserTenantRole[]

  @@index([name])
  @@index([status])
  @@map("states")
}

/// District within a state.
model District {
  id        String          @id @default(cuid())
  stateId   String
  name      String
  /// Short admin code (exactly 3 uppercase A–Z); unique per state.
  code      String
  status    GeoEntityStatus @default(ACTIVE)
  updatedBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  state           State            @relation(fields: [stateId], references: [id], onDelete: Restrict)
  ulbs            Ulb[]
  surveys         Survey[]
  userTenantRoles UserTenantRole[]

  @@unique([stateId, name])
  @@unique([stateId, code])
  @@index([stateId])
  @@index([status])
  @@map("districts")
}

/// Urban Local Body (Municipality / Nagar Nigam / Nagar Palika / Town Panchayat).
/// Operational multi-tenant grain for most RBAC and survey filtering.
/// LGD / municipality codes are globally unique.
model Ulb {
  id         String          @id @default(cuid())
  districtId String
  name       String
  code       String          @unique
  type       UlbType
  status     GeoEntityStatus @default(ACTIVE)
  updatedBy  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  district        District         @relation(fields: [districtId], references: [id], onDelete: Restrict)
  wards           Ward[]
  surveys         Survey[]
  userTenantRoles UserTenantRole[]

  @@unique([districtId, name])
  @@index([districtId])
  @@index([status])
  @@map("ulbs")
}

/// Ward within a ULB.
/// Soft-deleted via deletedAt. Active uniqueness of (ulbId, wardNumber) and (ulbId, wardCode)
/// is enforced by partial unique indexes in SQL (WHERE deletedAt IS NULL) — not expressible as @@unique in Prisma.
model Ward {
  id         String          @id @default(cuid())
  ulbId      String
  wardNumber String
  /// Mirrors Convex wardCode (e.g. AGR-W01). Optional for legacy rows until catalog sync.
  wardCode   String?
  wardName   String
  status     GeoEntityStatus @default(ACTIVE)
  updatedBy  String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?

  ulb             Ulb              @relation(fields: [ulbId], references: [id], onDelete: Restrict)
  surveys         Survey[]
  userTenantRoles UserTenantRole[]
  taxConfigs      TaxConfig[]

  @@index([ulbId])
  @@index([status])
  @@index([deletedAt])
  @@index([ulbId, wardCode])
  @@map("wards")
}

// -----------------------------------------------------------------------------
// Configuration Registry — reference catalogs + tax engine
// -----------------------------------------------------------------------------

model ReferenceCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  iconKey     String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries ReferenceEntry[]

  @@map("reference_categories")
}

model ReferenceEntry {
  id          String               @id @default(cuid())
  categoryId  String
  code        String
  name        String
  description String?
  value       String?
  status      ReferenceEntryStatus @default(ACTIVE)
  version     Int                  @default(1)
  sortOrder   Int                  @default(0)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  category                ReferenceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  taxConfigsAsAy          TaxConfig[]       @relation("TaxConfigAssessmentYear")
  rateCellsAsRoad         TaxRateCell[]     @relation("CellRoadWidth")
  rateCellsAsConstruction TaxRateCell[]     @relation("CellConstruction")

  @@unique([categoryId, code])
  @@index([categoryId, status])
  @@map("reference_entries")
}

/// One working tax configuration document per Ward × Assessment Year.
model TaxConfig {
  id               String          @id @default(cuid())
  wardId           String
  assessmentYearId String
  status           TaxConfigStatus @default(DRAFT)
  version          Int             @default(1)
  effectiveFrom    DateTime?
  propertyTaxPct   Decimal         @default(10) @db.Decimal(8, 4)
  waterTaxPct      Decimal         @default(0) @db.Decimal(8, 4)
  drainageTaxPct   Decimal         @default(0) @db.Decimal(8, 4)
  penaltyPct       Decimal         @default(0) @db.Decimal(8, 4)
  assessablePct    Decimal         @default(80) @db.Decimal(8, 4)
  publishedAt      DateTime?
  publishedBy      String?
  changeReason     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  ward           Ward               @relation(fields: [wardId], references: [id], onDelete: Cascade)
  assessmentYear ReferenceEntry     @relation("TaxConfigAssessmentYear", fields: [assessmentYearId], references: [id])
  cells          TaxRateCell[]
  versions       TaxConfigVersion[]

  @@unique([wardId, assessmentYearId])
  @@index([wardId, assessmentYearId])
  @@index([status])
  @@map("tax_configs")
}

model TaxRateCell {
  id                  String   @id @default(cuid())
  taxConfigId         String
  roadWidthEntryId    String
  constructionEntryId String
  annualRatePerSqFt   Decimal  @default(0) @db.Decimal(14, 4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  taxConfig         TaxConfig      @relation(fields: [taxConfigId], references: [id], onDelete: Cascade)
  roadWidthEntry    ReferenceEntry @relation("CellRoadWidth", fields: [roadWidthEntryId], references: [id])
  constructionEntry ReferenceEntry @relation("CellConstruction", fields: [constructionEntryId], references: [id])

  @@unique([taxConfigId, roadWidthEntryId, constructionEntryId])
  @@map("tax_rate_cells")
}

model TaxConfigVersion {
  id          String   @id @default(cuid())
  taxConfigId String
  version     Int
  snapshot    Json
  reason      String?
  createdBy   String?
  createdAt   DateTime @default(now())

  taxConfig TaxConfig @relation(fields: [taxConfigId], references: [id], onDelete: Cascade)

  @@index([taxConfigId, version])
  @@map("tax_config_versions")
}

model ConfigAuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  reason     String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("config_audit_logs")
}

// -----------------------------------------------------------------------------
// Identity & RBAC (Clerk + scoped role assignments)
// -----------------------------------------------------------------------------

/// Application user synced from Clerk. No password — identity is clerkUserId.
/// Roles are assigned only via UserTenantRole (never a direct role FK).
model User {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  email       String    @unique
  phone       String?
  fullName    String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  surveysCreated      Survey[]         @relation("SurveyCreatedBy")
  surveysAssigned     Survey[]         @relation("SurveyAssignedTo")
  tenantRoles         UserTenantRole[] @relation("UserTenantRoleAssignee")
  rolesAssigned       UserTenantRole[] @relation("UserTenantRoleAssigner")
  rolesDeactivated    UserTenantRole[] @relation("UserTenantRoleDeactivator")
  surveyAuditsChanged SurveyAudit[]    @relation("SurveyAuditChangedBy")
  securityAuditsActor SecurityAudit[]  @relation("SecurityAuditActor")
  importJobsCreated   ImportJob[]      @relation("ImportJobCreatedBy")
  exportJobsCreated   ExportJob[]      @relation("ExportJobCreatedBy")
  qcRemarksAuthored   QcRemark[]       @relation("QcRemarkAuthor")
  savedViews          SavedView[]      @relation("SavedViewOwner")

  @@index([isActive])
  @@index([fullName])
  @@map("users")
}

/// Named role (e.g. SURVEYOR, ADMIN). Permissions attached via RolePermission.
/// family: platform = SDV ops roles; department = municipal Admin/Clerk/Operator template.
model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  family      RoleFamily @default(PLATFORM)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  permissions     RolePermission[]
  userTenantRoles UserTenantRole[]

  @@index([family])
  @@map("roles")
}

enum RoleFamily {
  PLATFORM
  DEPARTMENT
}

/// Fine-grained permission (e.g. survey:create, report:export).
model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

/// Many-to-many join between Role and Permission.
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Tenant-scoped role assignment for a user.
/// Optional state/district/ulb/ward define the scope (null = broader/global).
model UserTenantRole {
  id            String    @id @default(cuid())
  userId        String
  roleId        String
  stateId       String?
  districtId    String?
  ulbId         String?
  wardId        String?
  assignedBy    String
  assignedAt    DateTime  @default(now())
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  deactivatedBy String?

  user        User      @relation("UserTenantRoleAssignee", fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  state       State?    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  district    District? @relation(fields: [districtId], references: [id], onDelete: Restrict)
  ulb         Ulb?      @relation(fields: [ulbId], references: [id], onDelete: Restrict)
  ward        Ward?     @relation(fields: [wardId], references: [id], onDelete: Restrict)
  assigner    User      @relation("UserTenantRoleAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)
  deactivator User?     @relation("UserTenantRoleDeactivator", fields: [deactivatedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([stateId])
  @@index([districtId])
  @@index([ulbId])
  @@index([wardId])
  @@index([isActive])
  @@index([userId, isActive])
  @@map("user_tenant_roles")
}

// -----------------------------------------------------------------------------
// Survey domain (property tax assessment record)
// -----------------------------------------------------------------------------

/// Central property tax survey record. Belongs to full geo hierarchy + creator.
/// Soft-deleted via deletedAt. Legacy string fields support data migration only.
/// Active identity: one assessment per (ulbId, propertyId, assessmentYear) among
/// non-deleted rows — enforced by partial unique index (WHERE deletedAt IS NULL).
model Survey {
  id String @id @default(uuid())

  // Tenant hierarchy (normalized FKs — do not duplicate tenant names)
  stateId      String
  districtId   String
  ulbId        String
  wardId       String
  createdById  String
  assignedToId String?
  assignedAt   DateTime?

  // Property identification
  /// Also GIN trigram (pg_trgm) in SQL for ILIKE contains — see surveys_*_trgm_idx migration
  propertyId      String
  localId         String?
  propertyIdOld   String?
  /// Also GIN trigram (pg_trgm) in SQL for ILIKE contains — see surveys_parcelNumber_trgm_idx
  parcelNumber    String?
  unitSubNo       String?
  sectorNo        String?
  constructedYear Int?
  isSlum          Boolean @default(false)
  /// Legacy denormalized ward number from source systems
  wardNumber      String?
  /// Legacy denormalized ULB code from source systems
  ulbCode         String?
  /// Legacy denormalized district name from source systems
  districtName    String?
  /// Legacy Convex document id (import provenance)
  legacySurveyId  String?

  // Owner / respondent
  /// Also GIN trigram (pg_trgm) in SQL for ILIKE contains — see surveys_respondentName_trgm_idx
  respondentName        String?
  relationshipWithOwner String?
  mobileNumber          String?
  alternateMobile       String?
  familySize            Int?

  // Address
  houseDoorNo String?
  locality    String?
  colony      String?
  city        String?
  pinCode     String?

  // Property classification
  ownershipType  OwnershipType?
  propertyUse    PropertyUse?
  propertyType   PropertyType?
  situation      Situation?
  roadType       RoadType?
  taxRateZone    TaxRateZone?
  assessmentYear AssessmentYear

  // Measurements
  plotAreaSqFt          Decimal? @db.Decimal(14, 4)
  plotAreaSqMeter       Decimal? @db.Decimal(14, 4)
  plinthAreaSqFt        Decimal? @db.Decimal(14, 4)
  plinthAreaSqMeter     Decimal? @db.Decimal(14, 4)
  totalBuiltAreaSqFt    Decimal? @db.Decimal(14, 4)
  totalBuiltAreaSqMeter Decimal? @db.Decimal(14, 4)

  // Utilities
  waterConnection       WaterConnection?
  sourceOfWater         SourceOfWater?
  sanitationType        SanitationType?
  solidWasteCollection  Boolean?
  electricityConsumerNo String?

  // GPS capture (Decimal fields are source of truth; gpsCoordinates is legacy)
  latitude          Decimal?       @db.Decimal(9, 6)
  longitude         Decimal?       @db.Decimal(9, 6)
  gpsAccuracyMeters Decimal?       @db.Decimal(8, 2)
  gpsSource         GpsSource?
  gpsProvider       String?
  gpsMockLocation   Boolean?
  /// @deprecated Use latitude/longitude
  gpsCoordinates    GPSCordinates?
  capturedAt        DateTime?

  // Workflow
  surveyStatus    SurveyStatus @default(DRAFT)
  qcStatus        QcStatus     @default(PENDING)
  serverVersion   Int          @default(1)
  completionPct   Int?
  clientUpdatedAt DateTime?
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  qcRemarks       String?

  // Audit / soft delete
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  state      State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  district   District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  ulb        Ulb      @relation(fields: [ulbId], references: [id], onDelete: Restrict)
  ward       Ward     @relation(fields: [wardId], references: [id], onDelete: Restrict)
  createdBy  User     @relation("SurveyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User?    @relation("SurveyAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  coOwners       CoOwner[]
  floors         Floor[]
  photos         Photo[]
  audits         SurveyAudit[]
  qcRemarkThread QcRemark[]

  // Active uniqueness of (ulbId, propertyId, assessmentYear) is enforced by a
  // partial unique index in SQL (WHERE deletedAt IS NULL) — not expressible as @@unique here.
  @@unique([legacySurveyId])
  @@index([stateId, surveyStatus])
  @@index([districtId, surveyStatus])
  @@index([ulbId, surveyStatus])
  @@index([wardId, surveyStatus])
  @@index([ulbId, qcStatus])
  @@index([wardId, qcStatus])
  @@index([wardId, parcelNumber])
  @@index([parcelNumber])
  @@index([createdById, createdAt])
  @@index([assignedToId, surveyStatus])
  @@index([surveyStatus, createdAt])
  @@index([qcStatus, createdAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([mobileNumber])
  @@index([propertyId])
  @@index([respondentName])
  @@index([localId])
  @@map("surveys")
}

/// Co-owner of the surveyed property (many per survey).
model CoOwner {
  id                  String   @id @default(cuid())
  surveyId            String
  ownerIndex          Int      @default(1)
  /// Also GIN trigram (pg_trgm) in SQL for ILIKE contains — see co_owners_name_trgm_idx
  name                String
  fatherOrHusbandName String?
  mobile              String?
  alternateMobile     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([surveyId, ownerIndex])
  @@map("co_owners")
}

/// Floor-level built-up detail for tax assessment (many per survey).
/// Multiple usage segments are allowed on the same floor level (mixed-use and
/// same usage with different construction, e.g. Residential Pakka + Tin Shed).
model Floor {
  id               String           @id @default(cuid())
  surveyId         String
  clientFloorId    String?
  floorPosition    FloorPosition
  usageFactor      UsageFactor
  usageType        UsageType?
  constructionType ConstructionType
  occupancy        String?
  areaSqFt         Decimal?         @db.Decimal(14, 4)
  position         Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, floorPosition, usageFactor, constructionType], map: "floors_surveyId_floorPosition_usageFactor_constructionType_key")
  @@index([surveyId])
  @@index([surveyId, clientFloorId])
  @@map("floors")
}

/// Field photo attached to a survey (private object storage).
model Photo {
  id              String           @id @default(cuid())
  surveyId        String
  photoType       PhotoType
  /// Cached delivery URL (signed/public); prefer objectKey for identity
  url             String
  sourceUrl       String?
  importStatus    String?
  storageProvider StorageProvider?
  bucket          String?
  objectKey       String?
  mimeType        String?
  sizeBytes       Int?
  checksum        String?
  etag            String?
  width           Int?
  height          Int?
  sizeKB          Int?
  capturedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([surveyId, photoType])
  @@index([objectKey])
  @@index([importStatus])
  @@map("photos")
}

/// Append-only QC remark thread between supervisor and surveyor.
model QcRemark {
  id         String    @id @default(cuid())
  surveyId   String
  authorId   String
  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  author User   @relation("QcRemarkAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([surveyId, createdAt])
  @@index([authorId])
  @@map("qc_remarks")
}

/// Field-level / action audit trail for survey changes (immutable; retained).
model SurveyAudit {
  id        String   @id @default(cuid())
  surveyId  String
  action    String
  oldValue  Json?
  newValue  Json?
  changedBy String
  changedAt DateTime @default(now())

  survey  Survey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  changer User   @relation("SurveyAuditChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([surveyId])
  @@index([changedBy])
  @@index([changedAt])
  @@index([surveyId, changedAt])
  @@map("survey_audits")
}

/// Immutable security / RBAC audit trail.
model SecurityAudit {
  id         String   @id @default(cuid())
  action     String
  actorId    String
  targetType String
  targetId   String?
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("SecurityAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("security_audits")
}

/// Async Excel/CSV import job processed by the background worker.
model ImportJob {
  id                String           @id @default(cuid())
  createdById       String
  status            JobStatus        @default(QUEUED)
  originalName      String
  mimeType          String?
  storageProvider   StorageProvider?
  bucket            String?
  objectKey         String?
  totalRows         Int              @default(0)
  processedRows     Int              @default(0)
  successCount      Int              @default(0)
  failureCount      Int              @default(0)
  photoSuccessCount Int              @default(0)
  photoFailureCount Int              @default(0)
  checkpoint        Json?
  errorReportKey    String?
  resultSummary     Json?
  errorMessage      String?
  resumeToken       String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  createdBy User @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@map("import_jobs")
}

/// Async report export job processed by the background worker.
model ExportJob {
  id              String           @id @default(cuid())
  createdById     String
  status          JobStatus        @default(QUEUED)
  reportType      String
  format          ExportFormat
  filters         Json?
  storageProvider StorageProvider?
  bucket          String?
  objectKey       String?
  filename        String?
  rowCount        Int              @default(0)
  downloadCount   Int              @default(0)
  errorMessage    String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy User @relation("ExportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([reportType, createdAt])
  @@map("export_jobs")
}

/// Persisted table filter/column views for survey registry.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  entity    String   @default("surveys")
  filters   Json
  columns   Json?
  sortBy    String?
  sortOrder String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("SavedViewOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity, name])
  @@index([userId, entity])
  @@map("saved_views")
}

/// Per-Convex-survey ETL resume / duplicate-detection state (keyed by legacySurveyId).
model MigrationState {
  id             String          @id @default(cuid())
  /// Convex surveys._id — permanent unique identity for ETL dedupe
  legacySurveyId String          @unique
  surveyId       String?
  status         MigrationStatus @default(PENDING)
  lastSyncedAt   DateTime?
  imagesImported Int             @default(0)
  imagesExpected Int             @default(0)
  retryCount     Int             @default(0)
  checksum       String?
  lastError      String?
  correlationId  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, updatedAt])
  @@index([surveyId])
  @@map("migration_state")
}

/// ETL job run (full migration, incremental sync, retry, validate).
model MigrationJob {
  id            String           @id @default(cuid())
  type          MigrationJobType
  status        String           @default("QUEUED")
  batchSize     Int              @default(100)
  cursor        String?
  startedAt     DateTime?
  finishedAt    DateTime?
  statsJson     Json?
  createdById   String?
  correlationId String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  logs     MigrationLog[]
  failures FailedImport[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([correlationId])
  @@map("migration_jobs")
}

/// Structured ETL log lines for a migration job.
model MigrationLog {
  id             String   @id @default(cuid())
  jobId          String
  level          String
  message        String
  legacySurveyId String?
  correlationId  String?
  metaJson       Json?
  createdAt      DateTime @default(now())

  job MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([legacySurveyId])
  @@map("migration_logs")
}

/// Failed survey import stages for retry / reporting.
model FailedImport {
  id             String    @id @default(cuid())
  jobId          String
  legacySurveyId String
  stage          String
  errorMessage   String
  stackTrace     String?
  payloadJson    Json?
  retryCount     Int       @default(0)
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  job MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, legacySurveyId, stage])
  @@index([legacySurveyId])
  @@index([resolvedAt])
  @@map("failed_imports")
}
